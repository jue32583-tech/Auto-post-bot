# Telegram application credentials from https://my.telegram.org
API_ID=your_api_id
API_HASH=your_api_hash

# Bot token from @BotFather
BOT_TOKEN=your_new_bot_token

# Single AI provider used for image understanding, Burmese captions, and hashtags.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional web-dashboard bridge; leave both empty when not used.
BRIDGE_BASE_URL=
TELEGRAM_BOT_BRIDGE_TOKEN=

# Bot writes runtime state locally; do not commit the resulting files.
SESSION_NAME=auto_post_bot_session
DATA_FILE=bot_data.json

# Responsiveness settings
POLL_INTERVAL=5
AI_TIMEOUT=8
